#!/system/bin/sh
#=======================================================
# DOCK - Docker wrapper for A730F
# Uso: dock [comando docker...]
#
# Exemplos:
#   dock                          → inicia Docker se parado
#   dock run --rm hello-world     → roda container
#   dock run --rm alpine sh       → shell no alpine
#   dock images                   → lista imagens
#   dock ps                       → containers ativos
#=======================================================
export SSL_CERT_FILE=/data/docker/certs/ca-certificates.crt

# Check if dockerd is actually running (not just stale socket)
if [ "$1" = "restart" ]; then
    shift
    echo "[dock] Forcing restart..."
    killall -9 dockerd containerd 2>/dev/null
    sleep 2
    rm -f /data/docker/run/*.sock /data/docker/run/*.pid /data/local/tmp/docker.sock
fi

if ! docker -H unix:///data/local/tmp/docker.sock info >/dev/null 2>&1; then
    echo "[dock] Starting Docker..."

    # Force kill
    killall -9 dockerd containerd 2>/dev/null
    sleep 2
    rm -f /data/docker/run/*.sock /data/docker/run/*.pid

    # Cgroups
    mount -t tmpfs none /sys/fs/cgroup 2>/dev/null
    for c in cpu cpuacct memory devices freezer pids; do
        mkdir -p /sys/fs/cgroup/$c
        mount -t cgroup -o $c none /sys/fs/cgroup/$c 2>/dev/null
    done

    # Paths
    mkdir -p /data/docker/{shim_sockets,certs,run,data,containerd/root,containerd/state}
    mount --bind /data/docker/shim_sockets /run/containerd/s 2>/dev/null
    ln -sf /data/local/tmp/docker27/* /system/bin/ 2>/dev/null

    # CA certs
    cat /system/etc/security/cacerts/*.0 > /data/docker/certs/ca-certificates.crt 2>/dev/null

    # Containerd
    containerd --address /data/docker/run/containerd.sock --root /data/docker/containerd/root --state /data/docker/containerd/state > /data/docker/containerd.log 2>&1 &
    for i in $(seq 10); do sleep 1; [ -S /data/docker/run/containerd.sock ] && break; done

    # Dockerd
    dockerd --host unix:///data/local/tmp/docker.sock --data-root /data/docker/data --exec-root /data/docker/run --containerd /data/docker/run/containerd.sock --storage-driver vfs --pidfile /data/docker/run/docker.pid --dns 8.8.8.8 > /data/docker/dockerd.log 2>&1 &
    for i in $(seq 10); do sleep 1; [ -S /data/local/tmp/docker.sock ] && chmod 666 /data/local/tmp/docker.sock && break; done

    echo "[dock] Ready!"
fi

# Run docker command
exec docker -H unix:///data/local/tmp/docker.sock "$@"
